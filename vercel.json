{
  "version": 2,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "backend/app/**",
        "backend/data/chennai_zones.json",
        "backend/data/zone_osm_data.json",
        "backend/data/interventions.json",
        "backend/data/climate_cache.json"
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "xr-spatial-tracking=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|cesium/|geo/|vr/|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
