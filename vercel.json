{
  "version": 2,
  "builds": [
    {"src": "frontend/package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}},
    {"src": "api/index.py", "use": "@vercel/python", "config": {"includeFiles": ["backend/app/**", "backend/data/chennai_zones.json", "backend/data/zone_osm_data.json", "backend/data/interventions.json", "backend/data/climate_cache.json"]}}
  ],
  "routes": [
    {"src": "/(.*)", "headers": {"Permissions-Policy": "xr-spatial-tracking=(self)"}, "continue": true},
    {"src": "/api/(.*)", "dest": "/api/index.py"},
    {"src": "/health", "dest": "/api/index.py"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
